    "@systemfsoftware/effect-schema-vite": "^2.0.3",
    "@systemfsoftware/tsconfig": "^1.3.3",
    "@types/node": "^24",
    "@types/semver": "^7.5.0",
    "@types/validate-npm-package-name": "^4.0.0",
    "@vitest/snapshot": "^4",
    "fast-check": "^4",
    "oxlint": "^1.77.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=24"
  }
}
