  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/are-the-types-wrong.git",
    "directory": "packages/arethetypeswrong"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "npm_config_ignore_scripts=true attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@loaderkit/resolve": "^1.0.2",
    "@systemfsoftware/npm-package": "^0.2.2",
    "cjs-module-lexer": "^1.2.3",
    "effect": "^4.0.0-rc.112",
    "semver": "^7.5.4",
    "typescript": "^6.0.3",
    "validate-npm-package-name": "^5.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0-rc.112",
    "@systemfsoftware/arethetypeswrong-cli": "^4.0.0",
    "@systemfsoftware/arethetypeswrong-recipes": "workspace:^",
