{
  "name": "@systemfsoftware/arethetypeswrong-cli",
  "version": "4.0.0",
  "description": "A CLI tool for arethetypeswrong.github.io — owned and maintained by systemfsoftware",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/are-the-types-wrong.git",
    "directory": "packages/arethetypeswrong-cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "attw": "./dist/main.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "node ./dist/main.mjs --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "prepack": "pnpm build"
  },
  "type": "module",
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/vitest": "catalog:",
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/arethetypeswrong": "workspace:*",
    "@systemfsoftware/arethetypeswrong-recipes": "workspace:*",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-vite": "catalog:",
    "@systemfsoftware/npm-package": "catalog:",
    "@systemfsoftware/oxlint-plugin-effect-dmmf": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
