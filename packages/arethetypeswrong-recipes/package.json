{
  "name": "@systemfsoftware/arethetypeswrong-recipes",
  "private": true,
  "version": "0.1.0",
  "description": "Synthetic problem-class recipes for arethetypeswrong — one package per Problem kind plus the types-companion pair and known-bad tree",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "dependencies": {
    "@systemfsoftware/npm-package": "catalog:"
  },
  "devDependencies": {
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/are-the-types-wrong.git",
    "directory": "packages/arethetypeswrong-recipes"
  },
  "homepage": "https://github.com/systemfsoftware/are-the-types-wrong/tree/main/packages/arethetypeswrong-recipes#readme"
}
