{
  "name": "@systemfsoftware/arethetypeswrong-cli",
  "version": "4.1.0",
  "description": "CLI tool for checking npm package entry points, module kinds, and export bindings across resolution modes",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/are-the-types-wrong.git",
    "directory": "apps/arethetypeswrong-cli"
  },
  "files": [
    "dist",
    "LICENSE",
    "agent-plugin"
  ],
  "bin": {
    "attw": "./dist/main.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "node ./dist/main.mjs --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "mutation": "stryker run",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "type": "module",
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/vitest": "catalog:",
    "@systemfsoftware/all": "catalog:",
    "@systemfsoftware/arethetypeswrong": "workspace:*",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-vite": "catalog:",
    "@systemfsoftware/oxlint-plugin-effect-dmmf": "catalog:",
    "@systemfsoftware/stryker-js-cli": "catalog:",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:",
    "@systemfsoftware/stryker-plugins": "catalog:",
    "@systemfsoftware/stryker-test-contribution": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
