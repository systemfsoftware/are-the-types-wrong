{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "dependsOn": []
    },
    "lint": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": []
    },
    "test:e2e": {
      "passThroughEnv": [
        "TESTCONTAINERS_RYUK_DISABLED",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "DOCKER_HOST",
        "CI"
      ],
      "cache": false,
      "outputLogs": "new-only",
      "dependsOn": [
        "^build"
      ]
    }
  }
}
